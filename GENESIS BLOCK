const char* ALPHABET = "123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz";

std::vector<unsigned char> decodeBase58(std::string input) {
    std::vector<unsigned char> result;
    result.push_back(0);

    for (char c : input) {
        if (std::isspace(c)) continue; // Handle pipe formatting

        const char* p = std::find(ALPHABET, ALPHABET + 58, c);
        if (p == ALPHABET + 58) return {}; 

        int carry = p - ALPHABET;
        for (auto& byte : result) {
            int val = byte * 58 + carry;
            byte = val & 0xFF;
            carry = val >> 8;
        }
        while (carry) {
            result.push_back(carry & 0xFF);
            carry >>= 8;
        }
    }

    // Restore leading zeros (Base58 '1')
    for (size_t i = 0; i < input.length() && input[i] == '1'; ++i) {
        result.push_back(0);
    }

    std::reverse(result.begin(), result.end());
    return result;
}

int main() {
    std::string input_stream;
    std::string line;

    // Read Base58 stream from stdin
    while (std::getline(std::cin, line)) {
        input_stream += line;
    }

    std::vector<unsigned char> decoded = decodeBase58(input_stream);

    if (decoded.empty()) {
        std::cerr << "CRITICAL: Stream decoding failed. Check Base58 integrity." << std::endl;
        return 1;
    }

    // Output formatted Hex Stream
    std::cout << "--- DECODED GENESIS LATTICE HEX ---" << std::endl;
    for (size_t i = 0; i < decoded.size(); ++i) {
        std::cout << "0x" << std::hex << std::setw(2) << std::setfill('0') << (int)decoded[i];
        
        if (i != decoded.size() - 1) {
            std::cout << ", ";
        }

        // Formatting for 8-byte blocks and 16-byte rows
        if ((i + 1) % 8 == 0) std::cout << " ";
        if ((i + 1) % 16 == 0) std::cout << std::endl;
    }

    std::cout << std::dec << "\n\n--- TOTAL SIZE: " << decoded.size() << " BYTES ---" << std::endl;

    return long(NULL);
}
